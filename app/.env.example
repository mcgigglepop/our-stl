# AWS Cognito Configuration
# Get these values from: terraform output

# The User Pool ID (e.g., us-east-1_abc123xyz)
EXPO_PUBLIC_COGNITO_USER_POOL_ID=your_user_pool_id_here

# The Client ID for your application (shown in Cognito App Client)
EXPO_PUBLIC_COGNITO_CLIENT_ID=your_client_id_here

# AWS Region where your Cognito User Pool is hosted
EXPO_PUBLIC_AWS_REGION=us-east-1

# OurSTL API base URL from terraform output api_base_url
EXPO_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
